<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Happy Propose Day</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
body{
margin:0;
min-height:100vh;
display:flex;
justify-content:center;
align-items:center;
background:radial-gradient(circle,#ffe6f2,#ffb6c1,#ff9a9e);
font-family:'Segoe UI';
overflow:hidden;
text-align:center;
}

.open-btn{
padding:15px 35px;
border:none;
border-radius:40px;
background:linear-gradient(45deg,#d63384,#ff5f9e);
color:white;
font-size:1.2rem;
cursor:pointer;
}

.popup{
position:fixed;
top:50%;
left:50%;
transform:translate(-50%,-50%) scale(0);
background:white;
padding:25px;
border-radius:25px;
transition:.5s;
}

.popup.active{
transform:translate(-50%,-50%) scale(1);
}

.fall{
position:absolute;
top:-10vh;
animation:fall 6s linear forwards;
}

@keyframes fall{
to{
transform:translateY(110vh);
opacity:0;
}
}

/* ---- NEW FOOTER STYLE ---- */
.floating-text{
position:fixed;
bottom:20px;
width:100%;
text-align:center;
font-size:18px;
font-weight:bold;
color:white;
text-shadow:0 0 10px #ff2e63;
letter-spacing:1px;
animation:fadeIn 2s ease-in-out;
}

@keyframes fadeIn{
from{opacity:0;}
to{opacity:1;}
}
</style>
</head>
<body>

<button class="open-btn" onclick="openPopup()">Propose to My Love 💍</button>

<div class="popup" id="popup">
<h1>💍 Happy Propose Day Lakshita 💍</h1>
<p> Apko Aaj bhi propose karte hue vaise hi pet me butterfly feel hoti hai jab maine apko first time propose kia tha🫠 ❤️</p>
<br>
<p> Kya app mujhe apna romantic tang karne wala person banaoge 🥰🤭 </p>
<button class="open-btn" onclick="closePopup()">Yes, I Will 💖</button>
</div>

<!-- FOOTER ADDED HERE -->
<div class="floating-text">Made for V💕L</div>
<script>
function openPopup(){
document.getElementById('popup').classList.add('active');
startFall();
}

function closePopup(){
document.getElementById('popup').classList.remove('active');
}

function startFall(){
setInterval(()=>{
const d=document.createElement('div');
d.className='fall';
d.innerHTML='💍';
d.style.left=Math.random()*innerWidth+'px';
document.body.appendChild(d);
setTimeout(()=>d.remove(),6000);
},300);
}
</script>

</body>
</html>
